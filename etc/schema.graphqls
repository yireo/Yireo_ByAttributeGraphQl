type Query {
    productAttribute (
        code: String @doc(description: "Attribute code of a filterable select or multiselect Product Attribute")
        category_id: Int @doc(description: "Optional ID of an active category within the current store")
    ): ProductAttribute
    @resolver(class: "Yireo\\ByAttributeGraphQl\\Model\\Resolver\\ProductAttribute")
    @doc(description: "The Product Attribute query returns data of a filterable Product Attribute")
    @cache(cacheIdentity: "Yireo\\ByAttributeGraphQl\\Model\\Resolver\\Identity")
}

type ProductAttribute @doc(description: "Product Attribute data") {
    id: String @doc(description: "Id of this Product Attribute")
    code: String @doc(description: "Code of this Product Attribute")
    label: String @doc(description: "Name of this Product Attribute")
    default_value: String @doc(description: "Default value for this Product Attribute")
    options: [ProductAttributeOption] @doc(description: "List of values for this Product Attribute")
}

type ProductAttributeOption @doc(description: "Product Attribute option") {
    label: String @doc(description: "Label of this Product Attribute option")
    value: String @doc(description: "Value of this Product Attribute option")
    product_count: Int @doc(description: "How many visible products in the current store have this value") @resolver(class: "Yireo\\ByAttributeGraphQl\\Model\\Resolver\\ProductCount")
}

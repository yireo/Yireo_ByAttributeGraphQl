{
    "name": "yireo/magento2-byattribute-graph-ql",
    "version": "1.0.0",
    "license": "OSL-3.0",
    "type": "magento2-module",
    "homepage": "https://www.yireo.com/software/magento-extensions/byattribute2",
    "description": "Show any listing of any product attribute in GraphQL",
    "keywords": [
        "composer-installer",
        "magento"
    ],
    "require": {
        "ext-pcre": "*",
        "magento/framework": "^103.0.6",
        "magento/module-catalog": "^104.0.6",
        "magento/module-catalog-inventory": "^100.4.6",
        "magento/module-eav": "^102.1.6",
        "magento/module-graph-ql": "^100.4.6",
        "magento/module-store": "^101.1.6",
        "php": ">=8.2 <8.6"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\ByAttributeGraphQl\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "suggest": {
        "yireo/magento2-byattribute2": "*"
    },
    "require-dev": {
        "ext-json": "*",
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0",
        "yireo/magento2-integration-test-helper": "~0.0"
    }
}